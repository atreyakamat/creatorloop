# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the site (used in auth email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: WhatsApp number for the landing-page CTA, digits with country code (e.g. 91XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# AI brief generator — server only, never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=
# Optional: override the model used for briefs (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
